# Listen-Claude runtime config

# Master switch — set to 0 to disable TTS without uninstalling.
TTS_ENABLED=1

# Engine:
#   edge       — Edge TTS, free Microsoft neural voices (RECOMMENDED).
#   system     — built-in OS TTS (macOS say / Windows SAPI / Linux espeak).
#   piper      — local Piper TTS, requires manual voice download.
#   elevenlabs — cloud, highest quality, requires paid API key.
#   fish       — local GPU TTS (fish-speech), best zh/en code-switching
#                + voice cloning. Auto-falls back to TTS_FALLBACK_ENGINE
#                when CUDA / fish-speech / the local server is missing,
#                so this is safe to enable even on no-GPU machines.
#                Install via: scripts/install-fish-speech.{ps1,sh}
TTS_ENGINE=edge

# Engine to use when the primary engine fails (e.g. fish-speech with no
# CUDA). Must NOT be `fish` itself.
TTS_FALLBACK_ENGINE=edge

# Voice identifier (engine-specific):
#   edge:             Edge TTS voice (e.g. zh-TW-HsiaoChenNeural, zh-CN-XiaoxiaoNeural)
#   system + macOS:   say -v name (e.g. Mei-Jia, Tingting, Sin-ji)
#   system + Windows: SAPI voice name (e.g. "Microsoft Yating Desktop")
#   piper:            voice .onnx filename or short name in PIPER_VOICES_DIR
#   elevenlabs:       voice_id from https://elevenlabs.io/app/voice-library
TTS_VOICE=zh-TW-HsiaoChenNeural

# Required only for TTS_ENGINE=elevenlabs.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Reading mode:
#   progress (default) — opening sentence + first ~4 bullet items
#                        ("what was done this turn")
#   full     — entire last assistant message
#   first    — only the first paragraph
#   summary  — every paragraph's first sentence + headings
TTS_MODE=progress

# Skip TTS for messages with fewer words than this.
TTS_MIN_WORDS=20

# Truncate longer messages to this many characters.
TTS_MAX_CHARS=500

# Rough words-per-minute (engine-specific mapping).
TTS_RATE=200

# Piper: directory holding .onnx + .onnx.json voice files.
# PIPER_VOICES_DIR=~/.cache/piper-voices

# --- fish-speech (TTS_ENGINE=fish) --------------------------------------
# Set the variables below only when you've run scripts/install-fish-speech.
# Defaults are sensible; uncomment to override.

# Where the fish-speech checkpoints live (install script writes here).
# FISH_MODEL_DIR=~/.cache/fish-speech

# Loopback address of the auto-started fish-speech API server.
# FISH_HOST=127.0.0.1
# FISH_PORT=7867

# Zero-shot voice clone: point at a 10-30 s, single-speaker, clean WAV/MP3
# and put its transcript in FISH_REFERENCE_TEXT. Leave both blank for the
# fish-speech default preset voice.
# FISH_REFERENCE_VOICE=
# FISH_REFERENCE_TEXT=

# Cold-start budget for the API server (model load on first request).
# FISH_STARTUP_TIMEOUT_SEC=60
# FISH_SYNTH_TIMEOUT_SEC=30

# Server exits after this many seconds of idle to free VRAM.
# FISH_IDLE_TIMEOUT_SEC=600

# Force CPU even when CUDA is present (debugging fallback behavior).
# FISH_FORCE_CPU=0

# Advanced: full override of the server launch command (default is
# `python -m tools.api_server` with paths derived from FISH_MODEL_DIR).
# FISH_SERVER_CMD=
